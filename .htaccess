Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Front controller: todas las rutas /api/* van a api/index.php
    # (salvo archivos reales, para no romper la propia index.php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]
</IfModule>
